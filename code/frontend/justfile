set fallback

# install web dependencies
install:
    pnpm install

# run Svelte type checking
check:
    pnpm check

# run prettier
fmt: 
    pnpm fmt

# run eslint
lint:
    pnpm lint

# run eslint & fix issues
lint-fix:
    pnpm lint --write

# run unit tests (vitest)
test:
    pnpm test:unit

# run unit tests with coverage report
coverage:
    pnpm test:coverage

# run e2e tests (playwright, needs backend on :8080)
test-e2e:
    pnpm test:e2e

# build Svelte static assets
build:
    pnpm build

# preview production build locally
preview:
    pnpm preview

# audit frontend dependencies
audit:
    pnpm audit --audit-level high

# run frontend development server
dev:
    pnpm dev
